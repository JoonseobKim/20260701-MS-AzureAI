    "import gradio as gr\n",
    "def welcome(name):\n",
    "  return f\"Welcometo Gradio, {name}!\"\n",
    "with gr.Blocks() as demo:\n",
    "  gr.Markdown(\n",
    "  \"\"\"\n",
    "  # Hello World!\n",
    "  Start typing below to see the output.\n",
    "  \"\"\")\n",
    "  inp= gr.Textbox(placeholder=\"What is your name?\")\n",
    "  out = gr.Textbox()\n",
    "  inp.change(welcome, inp, out)\n",
    "demo.launch()"
